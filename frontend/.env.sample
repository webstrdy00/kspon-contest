# Frontend 환경변수 설정 예시
# .env.local 파일로 복사해서 사용하세요

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# VWorld Map API Key (https://www.vworld.kr/dev/v4api.do 에서 발급)
# VWorld 타일맵 사용 시 필요 (선택사항 - 없으면 OpenStreetMap 사용)
NEXT_PUBLIC_VWORLD_KEY=

# 공공데이터포털 API Key (Frontend에서 직접 호출 시)
# https://www.data.go.kr 에서 발급
NEXT_PUBLIC_DATA_GO_KR_API_KEY=

# Google Analytics (선택사항)
NEXT_PUBLIC_GA_ID=

# 환경 설정
NEXT_PUBLIC_ENV=development